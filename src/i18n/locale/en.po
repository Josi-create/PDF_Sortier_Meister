#: src/gui/setup_wizard.py
msgid "Hier landen Ihre unsortierten (gescannten) PDFs — hierhin\nspeichert auch Ihr Scanner. Diesen Ordner wird das Programm\nbeim Start anzeigen."
msgstr "This is where your unsorted (scanned) PDFs arrive — your scanner\nsaves here too. The program shows this folder\nat startup."

#: src/gui/setup_wizard.py
